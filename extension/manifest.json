{
  "manifest_version": 3,
  "name": "LiveFinder Nero Autofill",
  "version": "0.3.0",
  "description": "Automate Nero free music review submissions from LiveFinder.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.nero.fan/*",
    "https://nero.fan/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nero.fan/*", "https://nero.fan/*"],
      "js": ["nero.js"],
      "run_at": "document_idle"
    }
  ]
}
