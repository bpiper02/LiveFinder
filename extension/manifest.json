{
  "manifest_version": 3,
  "name": "LiveFinder Nero Autofill",
  "version": "0.7.2",
  "minimum_chrome_version": "114",
  "description": "Discover reviewers, assist music submission autofill, automate Nero free submissions, and alert artists as queues move.",
  "permissions": [
    "alarms",
    "notifications",
    "tabs",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open LiveFinder Assist"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "https://www.nero.fan/*",
    "https://nero.fan/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nero.fan/*", "https://nero.fan/*"],
      "js": ["reviewer-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.nero.fan/*", "https://nero.fan/*"],
      "js": ["url-utils.js", "review-links.js", "reviewer-enrich.js", "autofill-core.js", "fullauto-contact.js", "assist.js", "addon-bypass.js", "nero.js", "queue-monitor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nero.fan/discover*", "https://nero.fan/discover*"],
      "js": ["discover-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.nero.fan/discover*", "https://nero.fan/discover*"],
      "js": ["url-utils.js", "review-links.js", "discover.js", "stream-enrich.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}