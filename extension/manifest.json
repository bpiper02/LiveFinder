{
  "manifest_version": 3,
  "name": "LiveFinder Nero Autofill",
  "version": "0.5.3",
  "description": "Discover Nero reviewers, automate free submissions, and alert artists as queues move.",
  "permissions": [
    "alarms",
    "notifications",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.nero.fan/*",
    "https://nero.fan/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nero.fan/*", "https://nero.fan/*"],
      "js": ["nero.js", "queue-monitor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.nero.fan/discover*", "https://nero.fan/discover*"],
      "js": ["url-utils.js", "discover.js"],
      "run_at": "document_idle"
    }
  ]
}
