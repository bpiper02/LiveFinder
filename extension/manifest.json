{
  "manifest_version": 3,
  "name": "LiveFinder Nero Autofill",
  "version": "0.1.0",
  "description": "Autofill Nero music review submission forms from LiveFinder.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.nero.fan/*", "https://nero.fan/*"],
  "content_scripts": [
    {
      "matches": ["https://www.nero.fan/*", "https://nero.fan/*"],
      "js": ["nero.js"],
      "run_at": "document_idle"
    }
  ]
}
